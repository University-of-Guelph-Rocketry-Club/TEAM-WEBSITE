# Frontend Environment Variables
# Copy this file to .env and update with your actual values

# API Configuration
VITE_API_URL=http://localhost:8000/api

# App Configuration
VITE_APP_NAME="UofG Rocketry Club"
VITE_APP_DESCRIPTION="University of Guelph Rocketry Club Website"

# Google Analytics (Optional)
# Get your Measurement ID from Google Analytics (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Maintenance Mode
# Set to 'true' to enable maintenance mode, 'false' or leave empty to disable
VITE_MAINTENANCE_MODE=false