# UofG Rocketry Club Chatbot Backend - Environment Configuration

# Database (SQLite for local, can use PostgreSQL for production)
DATABASE_URL=sqlite:///./chatbot.db

# OpenAI API Configuration (REQUIRED for AI responses)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Chatbot Model (gpt-3.5-turbo is cheaper, gpt-4 is smarter)
CHATBOT_MODEL=gpt-3.5-turbo

# Frontend URL (for generating correct links)
FRONTEND_BASE_URL=https://your-frontend-domain.vercel.app

# System Prompt (optional - customize chatbot personality)
CHATBOT_SYSTEM_PROMPT=You are a helpful assistant for the University of Guelph Rocketry Club. You help students with questions about rocketry, engineering, club activities, and projects.